{
  "name": "blanje",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm run typecheck && pnpm run test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist -t -m \"Deploy: $(git rev-parse --short HEAD)\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss@<=8.5.17": ">=8.5.18",
      "postcss@<=8.5.22": ">=8.5.23",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.17": ">=3.3.17"
    }
  }
}
